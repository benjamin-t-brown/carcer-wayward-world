{
  "name": "ceditor",
  "version": "1.0.0",
  "description": "Web-based editor for managing game asset JSON files",
  "type": "module",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "scripts": {
    "start": "npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test src/test/*.test.ts",
    "check": "npm run lint && npm run test && npm run build",
    "preview": "vite preview",
    "install:deps": "npm ci"
  },
  "dependencies": {
    "cors": "2.8.5",
    "express": "4.21.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/node": "20.19.24",
    "@types/react": "18.3.26",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "8.2.2",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "5.4.21"
  }
}

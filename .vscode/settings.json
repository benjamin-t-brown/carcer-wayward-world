{
  "cSpell.words": [
    "ALINEA",
    "AUTOTILE",
    "BLENDMODE",
    "Blit",
    "Carcer",
    "chebyshev",
    "DESPAWN",
    "disarmable",
    "Dockmaster",
    "equippable",
    "hiscore",
    "hiscores",
    "Inds",
    "Lockpick",
    "lockpicks",
    "Paintable",
    "panzoom",
    "quicksave",
    "Renderable",
    "Renderables",
    "Spritesheet",
    "stackable",
    "Targetable",
    "Tileset",
    "tilesets",
    "Townsperson",
    "unequip"
  ],
  "files.exclude": {
    "**/.DS_Store": true,
    "**/.git": true,
    "**/.hg": true,
    "**/.svn": true,
    "**/*.exe": true,
    "**/*.o": true,
    "**/*.d": true,
    "**/bin": true,
    "**/CVS": true,
    "**/node_modules": true
  },
  "C_Cpp.intelliSenseEngine": "disabled",
  "cmake.useCMakePresets": "always",
  "cmake.buildTarget": "CARCER",
  "[cpp]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
  }
}

{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake build (UCRT64)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/Invoke-Ucrt64.ps1",
      "args": ["cmake --preset ucrt64-debug && cmake --build --preset ucrt64-debug"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "CMake configure clang (UCRT64)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/Invoke-Ucrt64.ps1",
      "args": ["cmake --preset clang-debug"],
      "problemMatcher": []
    }
  ]
}

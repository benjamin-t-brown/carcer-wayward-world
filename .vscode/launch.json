{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "(gdb) Launch Tests UI Win",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\src\\TestUi.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}\\src",
      "environment": [
        {
          "name": "PATH",
          "value": "${config:cppdbg.msys2BinPath};${env:PATH}"
        }
      ],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "${config:cppdbg.miDebuggerPath}",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": ""
    },
    {
      "name": "(gdb) Launch Tests UI Mac",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/src/TestUi",
      "args": [],
      "cwd": "${workspaceFolder}/src",
      "preLaunchTask": ""
    }
  ]
}

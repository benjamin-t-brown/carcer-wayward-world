{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch CARCER (Windows)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\build\\cmake\\dev-debug\\CARCER.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}\\src",
      "environment": [
        {
          "name": "PATH",
          "value": "${config:cppdbg.msys2BinPath};${env:PATH}"
        }
      ],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "${config:cppdbg.miDebuggerPath}",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "Build CARCER"
    },
    {
      "name": "Launch CARCER (macOS)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/cmake/dev-debug/CARCER",
      "args": [],
      "cwd": "${workspaceFolder}/src",
      "preLaunchTask": "Build CARCER"
    },
    {
      "name": "Launch CARCER (Linux)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/cmake/dev-debug/CARCER",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/src",
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "Build CARCER"
    }
  ]
}
